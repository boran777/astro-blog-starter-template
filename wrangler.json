    "REPORT_FROM": "reports@mail.kocsistem.cftenant.com",
    "REPORT_TO": "boran.kirisoglu@kocsistem.com.tr",
    "REPORT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "REPORT_FALLBACK_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "allianz",
      "database_id": "f4816b4b-bd44-43e1-b3dd-4a8f3a5fa33d"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "7feb45688ec945febcbb7d89918227cf",
      "preview_id": "43d2bc4ac17f49d792299d2af3511881"
    }
  ],
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true
    }
  ]
}
