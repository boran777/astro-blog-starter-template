---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead
      title="Caseler | Allianz Siber Güvenlik Operasyon Merkezi"
      description="Allianz case kayıtları ve takip ekranı."
    />
  </head>
  <body>
    <Header />
    <main class="page-shell">
      <section class="page-hero">
        <div>
          <h1>Caseler</h1>
        </div>
      </section>

      <section class="panel">
        <h2>Yeni Case</h2>
        <form class="form-grid case-form" id="caseForm">
          <div class="field span-2">
            <label for="caseTitle">Case Başlığı</label>
            <input id="caseTitle" required />
          </div>
          <div class="field">
            <label for="caseCustomer">Üretici / Kaynak</label>
            <select id="caseCustomer" required></select>
          </div>
          <div class="field">
            <label for="caseStatus">Durum</label>
            <select id="caseStatus">
              <option>Açık</option>
              <option>İncelemede</option>
              <option>Beklemede</option>
              <option>Kapalı</option>
            </select>
          </div>
          <div class="field">
            <label for="casePriority">Öncelik</label>
            <select id="casePriority">
              <option>Orta</option>
              <option>Yüksek</option>
              <option>Düşük</option>
            </select>
          </div>
          <div class="field">
            <label for="caseOpenedDate">Açılış Tarihi</label>
            <input id="caseOpenedDate" type="date" />
          </div>
          <div class="field span-2">
            <label for="caseOwner">Sorumlu</label>
            <select id="caseOwner" class="owner-multiselect compact-multiselect" multiple required size="4"></select>
          </div>
          <div class="field span-2">
            <label for="caseSummary">Özet</label>
            <textarea id="caseSummary" placeholder="Case kapsamı, mevcut durum ve beklenen aksiyon"></textarea>
          </div>
          <div class="field span-2">
            <label for="caseUpdate">İlk Güncelleme</label>
            <textarea id="caseUpdate" placeholder="Case açılırken kayda geçecek ilk güncelleme"></textarea>
          </div>
          <div class="field span-6">
            <button class="button" type="submit">Case Kaydet</button>
          </div>
        </form>
      </section>

      <section class="panel" style="margin-top: 20px;">
        <h2>Case Listesi</h2>
        <div class="table-tools">
          <input id="caseSearch" placeholder="Ara..." />
          <select id="caseOwnerFilter"></select>
          <select id="caseStatusFilter"></select>
          <select id="casePriorityFilter"></select>
        </div>
        <div class="table-wrapper">
          <table>
            <colgroup>
              <col class="col-title" />
              <col class="col-producer" />
              <col class="col-owner" />
              <col class="col-status" />
              <col class="col-priority" />
              <col class="col-date" />
              <col class="col-actions" />
            </colgroup>
            <thead>
              <tr>
                <th>Case</th>
                <th>Üretici / Kaynak</th>
                <th>Sorumlu</th>
                <th>Durum</th>
                <th>Öncelik</th>
                <th>Açılış</th>
                <th>Aksiyon</th>
              </tr>
            </thead>
            <tbody id="caseBody"></tbody>
          </table>
        </div>
      </section>
    </main>

    <script>
      let cases = [];
      let selectedCaseId = null;

      const producerOptions = ["Check Point", "Cisco", "Citrix", "Cloudflare", "Palo Alto", "Proje", "Tufin", "Tüm üreticiler"];
      const ownerOptions = ["Allianz Ekibi", "Aykan", "Boran", "Can", "Koç Sistem Ekibi", "Salih", "Selcan", "Yurdaer", "Barış", "Erhan", "Yasin"];
      const caseStatusOptions = ["Açık", "İncelemede", "Beklemede", "Kapalı"];
      const priorityOptions = ["Düşük", "Orta", "Yüksek"];

      const escapeHtml = (value) =>
        String(value ?? "")
          .replaceAll("&", "&amp;")
          .replaceAll("<", "&lt;")
          .replaceAll(">", "&gt;")
          .replaceAll('"', "&quot;")
          .replaceAll("'", "&#039;");

      const pillClass = (value) => {
        if (value === "Kapalı") return "green";
        if (value === "Yüksek") return "red";
        if (value === "İncelemede" || value === "Orta") return "amber";
        return "blue";
      };

      const formatDate = (value) =>
        value ? new Intl.DateTimeFormat("tr-TR", { dateStyle: "medium" }).format(new Date(value)) : "-";

      function splitOwners(value) {
        return String(value || "")
          .split(",")
          .map((item) => item.trim())
          .filter(Boolean)
          .map((item) => (item === "Allianz Ekib" ? "Allianz Ekibi" : item));
      }

      function selectedOwners(selectId) {
        return [...document.getElementById(selectId).selectedOptions].map((option) => option.value).filter(Boolean);
      }

      function renderMultiOptions(selectId, values, selected = []) {
        const select = document.getElementById(selectId);
        const selectedSet = new Set(selected);
        select.innerHTML = values
          .map((value) => `<option value="${escapeHtml(value)}" ${selectedSet.has(value) ? "selected" : ""}>${escapeHtml(value)}</option>`)
          .join("");
      }

      function renderFixedOptions(selectId, values, { selected = [], placeholder = "" } = {}) {
        const select = document.getElementById(selectId);
        const selectedSet = new Set(selected);
        select.innerHTML = `${placeholder ? `<option value="">${placeholder}</option>` : ""}${values
          .map((value) => `<option value="${escapeHtml(value)}" ${selectedSet.has(value) ? "selected" : ""}>${escapeHtml(value)}</option>`)
          .join("")}`;
      }

      function renderOwnerChips(value) {
        const owners = splitOwners(value);
        if (!owners.length) return "-";
        return `<div class="chip-list">${owners.map((owner) => `<span class="chip">${escapeHtml(owner)}</span>`).join("")}</div>`;
      }

      function autoResizeTextarea(textarea) {
        textarea.style.height = "auto";
        textarea.style.height = `${textarea.scrollHeight}px`;
      }

      function autoResizeTextareas(scope = document) {
        scope.querySelectorAll("textarea").forEach(autoResizeTextarea);
      }

      function caseById(id) {
        return cases.find((item) => String(item.id) === String(id));
      }

      function setSelectOptions(selectId, label, values) {
        const select = document.getElementById(selectId);
        const current = select.value;
        select.innerHTML = `<option value="">${label}</option>`;
        [...new Set(values.filter(Boolean))]
          .sort((a, b) => a.localeCompare(b, "tr"))
          .forEach((value) => {
            const option = document.createElement("option");
            option.value = value;
            option.textContent = value;
            select.appendChild(option);
          });
        select.value = current;
      }

      function renderFilters() {
        renderFixedOptions("caseOwnerFilter", ownerOptions, {
          selected: [document.getElementById("caseOwnerFilter").value],
          placeholder: "Tüm Sorumlular",
        });
        setSelectOptions("caseStatusFilter", "Tüm Durumlar", cases.map((item) => item.status));
        setSelectOptions("casePriorityFilter", "Tüm Öncelikler", cases.map((item) => item.priority));
      }

      function filteredCases() {
        const search = document.getElementById("caseSearch").value.toLocaleLowerCase("tr");
        const owner = document.getElementById("caseOwnerFilter").value;
        const status = document.getElementById("caseStatusFilter").value;
        const priority = document.getElementById("casePriorityFilter").value;

        return cases.filter((item) => {
          const text = `${item.title} ${item.customer} ${item.owner} ${item.status} ${item.priority} ${item.summary}`
            .toLocaleLowerCase("tr");
          return (
            text.includes(search) &&
            (!owner || splitOwners(item.owner).includes(owner)) &&
            (!status || item.status === status) &&
            (!priority || item.priority === priority)
          );
        });
      }

      function expandedCaseRow(item) {
        if (String(item.id) !== String(selectedCaseId)) return "";
        const updates = item.updates || [];
        return `
          <tr class="expanded-row">
            <td colspan="7">
              <div class="inline-detail">
                <form class="task-detail" id="editCaseForm">
                  <div class="field span-2">
                    <label for="editCaseCustomer">Üretici / Kaynak</label>
                    <select id="editCaseCustomer">
                      ${producerOptions.map((producer) => `<option ${producer === item.customer ? "selected" : ""}>${escapeHtml(producer)}</option>`).join("")}
                    </select>
                  </div>
                  <div class="field span-2">
                    <label for="editCaseStatus">Durum</label>
                    <select id="editCaseStatus">
                      ${caseStatusOptions.map((status) => `<option ${status === item.status ? "selected" : ""}>${escapeHtml(status)}</option>`).join("")}
                    </select>
                  </div>
                  <div class="field span-2">
                    <label for="editCasePriority">Öncelik</label>
                    <select id="editCasePriority">
                      ${priorityOptions.map((priority) => `<option ${priority === item.priority ? "selected" : ""}>${escapeHtml(priority)}</option>`).join("")}
                    </select>
                  </div>
                  <div class="field span-2">
                    <label for="editCaseOwner">Sorumlu</label>
                    <select id="editCaseOwner" class="owner-multiselect" multiple size="4">
                      ${ownerOptions
                        .map((owner) => `<option value="${escapeHtml(owner)}" ${splitOwners(item.owner).includes(owner) ? "selected" : ""}>${escapeHtml(owner)}</option>`)
                        .join("")}
                    </select>
                  </div>
                  <div class="field span-2">
                    <label for="editCaseSummary">Özet</label>
                    <textarea id="editCaseSummary">${escapeHtml(item.summary || "")}</textarea>
                  </div>
                  <div class="field span-2">
                    <label for="newCaseUpdate">Yeni Güncelleme</label>
                    <textarea id="newCaseUpdate" placeholder="Bu case ile ilgili yeni gelişmeyi yazın"></textarea>
                  </div>
                  <div class="field span-6">
                    <button class="button" type="submit">Değişiklikleri Kaydet</button>
                  </div>
                </form>
                <div>
                  <h3>Güncelleme Geçmişi</h3>
                  <div class="history-list">
                    ${
                      updates.length
                        ? updates
                            .map(
                              (update) => `
                                <article class="history-item">
                                  <p>${escapeHtml(update.update_text)}</p>
                                  <p class="record-meta">${escapeHtml(update.action || "Güncelleme")} · ${new Date(update.created_at).toLocaleString("tr-TR")}</p>
                                </article>
                              `,
                            )
                            .join("")
                        : '<div class="empty-state">Bu case için henüz güncelleme yok.</div>'
                    }
                  </div>
                </div>
              </div>
            </td>
          </tr>
        `;
      }

      function renderCases() {
        const body = document.getElementById("caseBody");
        const rows = filteredCases();

        if (!rows.length) {
          body.innerHTML = '<tr><td colspan="7"><div class="empty-state">Gösterilecek case bulunamadı.</div></td></tr>';
          return;
        }

        body.innerHTML = rows
          .map(
            (item) => `
              <tr>
                <td>
                  <strong>${escapeHtml(item.title)}</strong>
                  <p class="record-meta">${escapeHtml(item.summary || "Özet girilmemiş.")}</p>
                </td>
                <td>${escapeHtml(item.customer)}</td>
                <td>${renderOwnerChips(item.owner)}</td>
                <td><span class="pill ${pillClass(item.status)}">${escapeHtml(item.status)}</span></td>
                <td><span class="pill ${pillClass(item.priority)}">${escapeHtml(item.priority)}</span></td>
                <td>${formatDate(item.opened_date)}</td>
                <td>
                  <div class="row-actions">
                    <button class="button secondary" data-action="select" data-id="${item.id}">Detay</button>
                    <button class="button secondary" data-action="close" data-id="${item.id}">Kapat</button>
                    <button class="button danger" data-action="delete" data-id="${item.id}">Sil</button>
                  </div>
                </td>
              </tr>
              ${expandedCaseRow(item)}
            `,
          )
          .join("");
      }

      async function loadCases() {
        const response = await fetch("/api/cases");
        if (!response.ok) throw new Error("Caseler alınamadı.");
        cases = await response.json();
        renderFixedOptions("caseCustomer", producerOptions);
        renderMultiOptions("caseOwner", ownerOptions);
        renderFilters();
        renderCases();
        if (selectedCaseId && !caseById(selectedCaseId)) selectedCaseId = null;
        autoResizeTextareas(document.getElementById("caseBody"));
      }

      async function createCase(event) {
        event.preventDefault();
        const payload = {
          title: document.getElementById("caseTitle").value.trim(),
          customer: document.getElementById("caseCustomer").value,
          owner: selectedOwners("caseOwner").join(", "),
          status: document.getElementById("caseStatus").value,
          priority: document.getElementById("casePriority").value,
          opened_date: document.getElementById("caseOpenedDate").value,
          summary: document.getElementById("caseSummary").value.trim(),
          update_text: document.getElementById("caseUpdate").value.trim(),
        };
        if (!payload.owner) {
          alert("En az bir sorumlu seçin.");
          return;
        }
        const response = await fetch("/api/cases", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!response.ok) throw new Error("Case kaydedilemedi.");
        event.target.reset();
        autoResizeTextareas(event.target);
        await loadCases();
      }

      async function updateCase(id, patch) {
        const current = cases.find((item) => String(item.id) === String(id));
        if (!current) return;
        const response = await fetch(`/api/cases/${id}`, {
          method: "PUT",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ ...current, ...patch }),
        });
        if (!response.ok) throw new Error("Case güncellenemedi.");
        await loadCases();
      }

      async function updateSelectedCase(event) {
        event.preventDefault();
        const current = caseById(selectedCaseId);
        if (!current) return;
        const payload = {
          title: current.title,
          customer: document.getElementById("editCaseCustomer").value,
          owner: selectedOwners("editCaseOwner").join(", "),
          status: document.getElementById("editCaseStatus").value,
          priority: document.getElementById("editCasePriority").value,
          opened_date: current.opened_date || "",
          summary: document.getElementById("editCaseSummary").value.trim(),
          update_text: document.getElementById("newCaseUpdate").value.trim(),
        };
        if (!payload.owner) {
          alert("En az bir sorumlu seçin.");
          return;
        }
        await updateCase(current.id, payload);
      }

      async function deleteCase(id) {
        if (!confirm("Bu case silinsin mi?")) return;
        const response = await fetch(`/api/cases/${id}`, { method: "DELETE" });
        if (!response.ok) throw new Error("Case silinemedi.");
        await loadCases();
      }

      document.getElementById("caseForm").addEventListener("submit", createCase);
      ["caseSearch", "caseOwnerFilter", "caseStatusFilter", "casePriorityFilter"].forEach((id) => {
        document.getElementById(id).addEventListener("input", renderCases);
      });
      document.addEventListener("click", (event) => {
        const button = event.target.closest("button[data-action]");
        if (!button) return;
        if (button.dataset.action === "select") {
          selectedCaseId = String(selectedCaseId) === String(button.dataset.id) ? null : button.dataset.id;
          renderCases();
          autoResizeTextareas(document.getElementById("caseBody"));
        }
        if (button.dataset.action === "close") updateCase(button.dataset.id, { status: "Kapalı" }).catch(console.error);
        if (button.dataset.action === "delete") deleteCase(button.dataset.id).catch(console.error);
      });
      document.addEventListener("submit", (event) => {
        if (event.target.id === "editCaseForm") {
          updateSelectedCase(event).catch(console.error);
        }
      });
      document.addEventListener("input", (event) => {
        if (event.target instanceof HTMLTextAreaElement) {
          autoResizeTextarea(event.target);
        }
      });

      loadCases().catch((error) => {
        document.getElementById("caseBody").innerHTML =
          '<tr><td colspan="7"><div class="empty-state">Veri yüklenemedi. D1 şemasını kontrol edin.</div></td></tr>';
        console.error(error);
      });
    </script>
  </body>
</html>
